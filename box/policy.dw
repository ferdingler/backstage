// Authority for the Backstage demo: a sandboxed shell inside scratch, one model, and the agent API.
// box/run.py fills in canonical local paths. Anything not permitted is denied.
// Native Python runtime grants live separately in box.toml; this file governs
// gateway traffic and Strands Shell operations, not every Python system call.

// One model, one region, streaming only. The SDK URL-encodes the model's colon.
// Require gateway-decrypted TLS; credentials are injected from aws://bedrock.
@id("bedrock_connect")
permit (principal, action == Box::Action::"net:connect", resource)
when {
  context.input.host == "bedrock-runtime.us-west-2.amazonaws.com" &&
  context.input.port == 443
};

@id("bedrock_converse_stream")
permit (principal, action == Box::Action::"http:request", resource)
when {
  context.input.host == "bedrock-runtime.us-west-2.amazonaws.com" &&
  context.input.port == 443 &&
  context.input.intercepted &&
  context.input.method == "POST" &&
  context.input.path == "/model/us.anthropic.claude-sonnet-4-5-20250929-v1%3A0/converse-stream" &&
  context.input.body_bytes > 0 && context.input.body_bytes <= 1048576
};

// Agent-only listener; it independently rejects host and audience operations.
@id("agent_connect")
permit (principal, action == Box::Action::"net:connect", resource)
when { context.input.host == "127.0.0.1" && context.input.port == 3003 };

@id("agent_read")
permit (principal, action == Box::Action::"http:request", resource)
when {
  context.input.host == "127.0.0.1" && context.input.port == 3003 &&
  !context.input.intercepted &&
  context.input.method == "GET" && context.input.path == "/api/agent/state" &&
  context.input.body_bytes == 0
};

// Bookkeeping needs only UUIDs, status labels, and counters.
@id("agent_bookkeeping")
permit (principal, action == Box::Action::"http:request", resource)
when {
  context.input.host == "127.0.0.1" && context.input.port == 3003 &&
  !context.input.intercepted &&
  context.input.method == "POST" &&
  ["/api/agent/claim", "/api/agent/heartbeat", "/api/agent/ack",
   "/api/agent/fail", "/api/agent/activity"].contains(context.input.path) &&
  context.input.body_bytes > 0 && context.input.body_bytes <= 512
};

// Match the web app's 8 KiB request ceiling for answers and recommendations.
@id("agent_result")
permit (principal, action == Box::Action::"http:request", resource)
when {
  context.input.host == "127.0.0.1" && context.input.port == 3003 &&
  !context.input.intercepted &&
  context.input.method == "POST" && context.input.path == "/api/agent/result" &&
  context.input.body_bytes > 0 && context.input.body_bytes <= 8192
};

// Programs Strands Shell implements itself (shell:exec, never host binaries).
// Each file they touch, python3 included, still meets the fs:* rules below, so
// the audience can run real commands while everything stays inside scratch.
@id("shell_sandbox_programs")
permit (principal, action == Box::Action::"shell:exec", resource)
when {
  (context.input.cwd == "@SCRATCH@" || context.input.cwd like "@SCRATCH@/*") &&
  ["printf", "echo", "cat", "ls", "pwd", "cd", "date", "wc", "head", "tail",
   "grep", "sort", "uniq", "touch", "mkdir", "python3", "python"]
    .contains(context.input.program)
};

// Read, list, and enter anything inside scratch. Paths are canonicalized
// before authorization, so "..", symlinks, and absolute paths leave it.
@id("scratch_read")
permit (principal, action == Box::Action::"fs:read", resource)
when {
  (context.input.path == "@POLICY_SCRATCH@" || context.input.path like "@POLICY_SCRATCH@/*") &&
  [Box::FsReadOperation::"read_content", Box::FsReadOperation::"read_metadata",
   Box::FsReadOperation::"enumerate", Box::FsReadOperation::"change_dir"]
    .contains(context.input.operation)
};

// Create and write files and folders inside scratch. No chmod or symlinks.
@id("scratch_write")
permit (principal, action == Box::Action::"fs:write", resource)
when {
  context.input.path like "@POLICY_SCRATCH@/*" &&
  [Box::FsWriteOperation::"write_content", Box::FsWriteOperation::"create_dir"]
    .contains(context.input.operation)
};

// Explicit denials give actionable feedback and resist accidental later grants.
@id("no_host_programs")
@description("Backstage cannot launch host programs. Use the built-in shell commands or python3 inside scratch.")
forbid (principal, action == Box::Action::"shell:spawn", resource);

@id("no_mcp")
@description("Backstage has no MCP access. Use the supplied session tools.")
forbid (principal, action == Box::Action::"mcp:call", resource);

@id("no_delete")
@description("Backstage cannot delete files. Overwrite them inside scratch instead.")
forbid (principal, action == Box::Action::"fs:delete", resource);

@id("no_move")
@description("Backstage cannot move files. Write a new file inside scratch instead.")
forbid (principal, action == Box::Action::"fs:move", resource);
