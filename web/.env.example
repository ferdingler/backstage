# Copy startup values into your shell or process supervisor. Never put secrets here.
# The custom server ALWAYS binds to loopback.
PUBLIC_PORT=3000
HOST_PORT=3001
AGENT_PORT=3003
AUDIENCE_URL=http://127.0.0.1:3000
PUBLIC_ORIGINS=http://127.0.0.1:3000
HOST_ORIGINS=http://127.0.0.1:3001
# DynamoDB table; credentials and region come from the AWS SDK chain.
BACKSTAGE_TABLE=backstage
AWS_PROFILE=bedrock
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000
QUESTION_CAP=200
QUESTION_RATE=5
VOTE_RATE=30
READ_RATE=60
COOKIE_IP_RATE=120
WRITE_IP_RATE=300
WRITE_GLOBAL_RATE=300
RATE_WINDOW_MS=60000
MODEL_CALL_BUDGET=100
CLOSING_CALL_RESERVE=6
WORK_LEASE_MS=90000
# Only set to the reverse proxy connection peer. It must replace forwarding headers.
# TRUSTED_PROXY_IP=127.0.0.1
# Public build only: which X-Forwarded-For entry, counted from the right, is the client.
# FORWARDED_HOPS=1
